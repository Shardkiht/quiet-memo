{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试当前测试文件",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q", "-s"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "调试全部测试",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
